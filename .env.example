# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variable template for the RAG System
#
# Copy this file to .env and fill in your values:
#   copy .env.example .env       (Windows CMD)
#   cp .env.example .env         (PowerShell / Linux / macOS)
#
# NEVER commit .env to Git. It is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required: Google Gemini API Key ──────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Gemini model name ───────────────────────────────────────────────
# Default is gemini-3.1-flash-lite (cost-efficient text generation)
# See https://ai.google.dev/gemini-api/docs/models for currently supported models.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Optional: Logging level ───────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
