# ──────────────────────────────────────────────────────────────────────────────
# .gitignore for RAG System
# ──────────────────────────────────────────────────────────────────────────────

# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── ChromaDB persistent storage (large binary files; re-generated by ingest) ──
chroma_data/

# ── Python cache files ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# ── Uploaded / source documents (may be confidential; re-supply manually) ─────
data/documents/*.pdf

# ── HuggingFace model cache downloaded at runtime ────────────────────────────
.cache/

# ── Streamlit cache/config ────────────────────────────────────────────────────
.streamlit/

# ── OS & editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp
*.log

# ── Test / coverage artefacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Build artefacts ───────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Jupyter notebooks checkpoints ─────────────────────────────────────────────
.ipynb_checkpoints/

# ── Verification output (generated by verify_env.py) ─────────────────────────
verify_output.txt
